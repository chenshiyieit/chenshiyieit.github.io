---
import { getCollection, render } from 'astro:content';
import AcademicLayout from '../layouts/AcademicLayout.astro';
import Publication from './Publication.astro';
import { comparePeople } from '../lib/people-order.mjs';
import { pathFor, assetPath, scholar, type Locale } from '../lib/site';
interface Props { locale: Locale; slug: string; page: string; }
const { locale, slug, page } = Astro.props;
const en = locale === 'en';
const entries = await getCollection('pages');
const entry = entries.find((item) => item.data.locale === locale && item.data.page === page);
if (!entry) throw new Error(`Missing Markdown page: ${locale}/${page}`);
const { Content } = await render(entry);
const alumniEntry = page === 'people' ? entries.find((item) => item.data.locale === locale && item.data.page === 'alumni') : undefined;
const AlumniContent = alumniEntry ? (await render(alumniEntry)).Content : undefined;
const papers = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const selected = papers.filter((paper) => paper.data.selected)
  .sort((a, b) => (a.data.selectedRank ?? Infinity) - (b.data.selectedRank ?? Infinity));
const years = [...new Set(papers.map((paper) => paper.data.year))];
const members = page === 'people' ? (await getCollection('people')).sort(comparePeople) : [];
const memberGroups = [
  { id: 'peking', en: 'Peking University', zh: '北京大学' },
  { id: 'sjtu-eit', en: 'Shanghai Jiao Tong University & Eastern Institute of Technology, Ningbo', zh: '上海交通大学 & 宁波东方理工大学' },
  { id: 'polyu-eit', en: 'The Hong Kong Polytechnic University & Eastern Institute of Technology, Ningbo', zh: '香港理工大学 & 宁波东方理工大学' },
];
const photos = page === 'gallery' ? (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order) : [];
---
<AcademicLayout locale={locale} slug={slug} title={entry.data.title} description={entry.data.description} eyebrow={entry.data.eyebrow}>
  <div class="prose"><Content /></div>

  {page === 'home' && <>
    <section class="selected-section" aria-labelledby="selected-heading">
      <div class="section-heading"><h2 id="selected-heading">{en ? 'Selected publications' : '代表论文'}</h2><a class="small-link" href={pathFor(locale, 'publications')}>{en ? 'All publications' : '全部论文'} <span aria-hidden="true">→</span></a></div>
      <ol class="publications-list">{selected.map((paper) => <Publication paper={paper} locale={locale} />)}</ol>
      <a class="text-link" href={scholar}>{en ? 'View Google Scholar profile' : '访问 Google Scholar 学术主页'} <span aria-hidden="true">↗</span></a>
    </section>
  </>}

  {page === 'publications' && <>
    <div class="bibliography-meta"><span>{papers.length} {en ? 'publications' : '篇论文'}</span><a href={scholar}>Google Scholar <span aria-hidden="true">↗</span></a></div>
    <nav class="year-nav" aria-label={en ? 'Publication years' : '论文年份'}>{years.map((year) => <a href={`#year-${year}`}>{year}</a>)}</nav>
    {years.map((year) => <section class="year-section" aria-labelledby={`year-${year}`}>
      <h2 id={`year-${year}`} class="year-heading">{year}</h2>
      <ol class="publications-list">{papers.filter((paper) => paper.data.year === year).map((paper) => <Publication paper={paper} locale={locale} />)}</ol>
    </section>)}
  </>}

  {page === 'people' && <>
    <section aria-labelledby="current-members">
      <h2 id="current-members" class="section-title">{en ? 'Current PhD Students' : '在读博士生'}</h2>
      {memberGroups.map((group) => <section class="member-group" aria-labelledby={`school-${group.id}`}>
        <h3 id={`school-${group.id}`} class="member-group-title">{en ? group.en : group.zh}</h3>
        <div class="members">{members.filter(({ data: member }) => member.group === group.id).map(({ data: member }) => <article class="member">
          {member.image && <img src={assetPath(member.image)} alt={en ? member.name : member.nameZh} width="160" height="190" loading="lazy" />}
          <div><h4>{en ? member.name : member.nameZh} <span class="member-native">{en ? member.nameZh : member.name}</span></h4>
            <p class="member-role">{en ? member.role : member.roleZh}{member.pi && <span class="member-pi" title={en ? 'Principal Investigator' : '课题组负责人'}> · PI</span>}</p>
            <p>{en ? member.description : member.descriptionZh}</p>
            {member.homepage && <a class="small-link" href={member.homepage}>{en ? member.homepageLabel : member.homepageLabelZh} <span aria-hidden="true">↗</span></a>}
          </div>
        </article>)}</div>
      </section>)}
    </section>
    <section class="alumni-section" aria-labelledby="alumni-heading">
      <h2 id="alumni-heading">{en ? 'Past members' : '往届成员'}</h2>
      {AlumniContent && <div class="prose alumni-content"><AlumniContent /></div>}
    </section>
  </>}

  {page === 'gallery' && <div class="gallery-grid">{photos.map(({ data: photo }) => <figure>
    <a href={assetPath(photo.image)}><img src={assetPath(photo.image)} alt={en ? photo.title : photo.titleZh} width="640" height="750" loading="lazy" /></a>
    <figcaption><h2>{en ? photo.title : photo.titleZh}</h2><p>{en ? photo.caption : photo.captionZh}</p><a class="small-link" href={photo.source}>{en ? 'Photo source' : '照片来源'} <span aria-hidden="true">↗</span></a></figcaption>
  </figure>)}</div>}
</AcademicLayout>
