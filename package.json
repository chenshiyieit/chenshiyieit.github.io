{
  "name": "shiyi-chen-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:pages": "node scripts/build-pages.mjs",
    "verify:pages": "npm run build:pages && node --test tests/pages-deploy.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@fontsource/raleway": "^5.2.6",
    "@fontsource/source-sans-pro": "^5.2.5",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
